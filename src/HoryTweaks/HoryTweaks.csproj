<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OutputType>Library</OutputType>
		<AssemblyName>HoryTweaks</AssemblyName>
		<RootNamespace>BetterAmongUs</RootNamespace>
		<Configurations>Debug;Release;Beta</Configurations>
		<VersionPrefix>0.1.3</VersionPrefix>
		<VersionSuffix Condition="'$(Configuration)' == 'Beta'">beta-0</VersionSuffix>
		<GitVersion>false</GitVersion>
	</PropertyGroup>

	<!-- Build Metadata -->
	<PropertyGroup>
		<BuildDate>$([System.DateTime]::Now.ToString("MM.dd.yyyy"))</BuildDate>
	</PropertyGroup>

	<!-- Define metadata for ThisAssembly.Metadata -->
	<ItemGroup>
		<AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
		<AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
	</ItemGroup>

	<!-- Expose the computed version to the BuildInfo source generator -->
	<ItemGroup>
		<CompilerVisibleProperty Include="Version" />
	</ItemGroup>

	<!-- Game Path Configuration -->
	<PropertyGroup>
		<CopyToGame Condition="'$(CopyToGame)' == ''">true</CopyToGame>
		<ModPathFile>build\mod_folder_path</ModPathFile>
	</PropertyGroup>

	<!-- Target to read game path (only if CopyToGame is true) -->
	<Target Name="ReadGamePath">
		<PropertyGroup>
			<GamePath Condition="Exists('$(ModPathFile)')">
				$([System.IO.File]::ReadAllText('$(ModPathFile)').Trim())
			</GamePath>
		</PropertyGroup>
		<Message Text="Game path read: $(GamePath)" Condition="'$(GamePath)' != ''" Importance="low" />
	</Target>

	<!-- Unity-independent rules shared with the test suite; compiled into the plugin, never shipped as Core.dll -->
	<ItemGroup>
		<Compile Include="..\HoryTweaks.Core\**\*.cs" Exclude="..\HoryTweaks.Core\bin\**;..\HoryTweaks.Core\obj\**;..\HoryTweaks.Core\Properties\AssemblyInfo.cs" />
	</ItemGroup>

	<!-- Copy Mod to Game Folder -->
	<Target Name="CopyModToGame" AfterTargets="PostBuildEvent" Condition="'$(CopyToGame)' == 'true'" DependsOnTargets="ReadGamePath">

		<Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(GamePath)" SkipUnchangedFiles="true" Condition="'$(GamePath)' != '' and Exists('$(GamePath)')">
			<Output TaskParameter="CopiedFiles" ItemName="CopiedMods" />
		</Copy>

		<Message Text="Successfully copied mod to: $(GamePath)" Importance="high" Condition="'@(CopiedMods)' != ''" />

		<Warning Text="Game path not found. Create $(ModPathFile) with game folder path." Condition="'$(CopyToGame)' == 'true' and ('$(GamePath)' == '' or !Exists('$(GamePath)'))" />
	</Target>

	<!-- Source generation and IL2CPP safety checks run inside the compiler -->
	<ItemGroup>
		<ProjectReference Include="..\HoryTweaks.Generators\HoryTweaks.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<AdditionalFiles Include="Resources\Lang\en_US.json" />
	</ItemGroup>

	<!-- NuGet Core Packages -->
	<ItemGroup>
		<PackageReference Include="AmongUs.GameLibs.Steam" />
		<PackageReference Include="BepInEx.IL2CPP.MSBuild">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Private="false" ExcludeAssets="runtime;native" />
		<PackageReference Include="Costura.Fody">
			<IncludeAssets>runtime; compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<!-- NuGet Info Packages -->
	<ItemGroup>
		<PackageReference Include="Semver" />
		<PackageReference Include="GitInfo">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="ThisAssembly.Metadata">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<GeneratePathProperty>true</GeneratePathProperty>
		</PackageReference>
	</ItemGroup>

	<!-- Embedded Resources -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\**\*" />
	</ItemGroup>
</Project>
