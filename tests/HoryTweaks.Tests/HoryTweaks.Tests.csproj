<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<IsPackable>false</IsPackable>
		<RootNamespace>BetterAmongUs.Tests</RootNamespace>
	</PropertyGroup>

	<!-- Game-independent moderation logic is compiled directly; the mod assembly itself needs the IL2CPP game libraries. -->
	<ItemGroup>
		<Compile Include="../../src/Modules/Moderation/ModerationRules.cs" />
		<Compile Include="../../src/Modules/Moderation/ModerationHistory.cs" />
		<Compile Include="../../src/Modules/Moderation/ModerationLists.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>
</Project>
